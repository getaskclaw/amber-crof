   },
   "encode": {
    "enter": {
     "x": {
      "signal": "0.5 * width + 4"
     },
     "y": {
      "signal": "0.5 * height - datum.f * radius"
     },
     "text": {
      "signal": "format(datum.f, '.0%')"
     },
     "fontSize": {
      "value": 10
     },
     "fill": {
      "value": "#9ab8bd"
     },
     "align": {
      "value": "left"
     },
     "baseline": {
      "value": "bottom"
     },
     "font": {
      "value": "Noto Sans CJK SC"
     }
    }
   }
  },
  {
   "type": "rule",
   "from": {
    "data": "keys"
   },
   "encode": {
    "enter": {
     "x": {
      "signal": "0.5 * width"
     },
     "y": {
      "signal": "0.5 * height"
     },
     "x2": {
      "signal": "0.5 * width + radius * cos(scale('angular', datum.data))"
     },
     "y2": {
      "signal": "0.5 * height + radius * sin(scale('angular', datum.data))"
     },
     "stroke": {
      "value": "#9fcdd4"
     },
     "strokeWidth": {
      "value": 1
     }
    }
   }
  },
  {
   "type": "text",
   "from": {
    "data": "keys"
   },
   "encode": {
    "enter": {
     "x": {
      "signal": "0.5 * width + (radius + 26) * cos(scale('angular', datum.data))"
     },
     "y": {
      "signal": "0.5 * height + (radius + 26) * sin(scale('angular', datum.data))"
     },
     "text": {
      "field": "data"
     },
     "fontSize": {
      "value": 15
     },
     "fontWeight": {
      "value": "bold"
     },
     "align": {
      "value": "center"
     },
     "baseline": {
      "value": "middle"
     },
     "fill": {
      "value": "#222"
     },
     "font": {
      "value": "Noto Sans CJK SC"
     }
    }
   }
  },
  {
   "type": "group",
   "from": {
    "facet": {
     "name": "cats",
     "data": "table",
     "groupby": "category"
    }
   },
   "marks": [
    {
     "type": "line",
     "from": {
      "data": "cats"
     },
     "encode": {
      "enter": {
       "x": {
        "signal": "0.5 * width + scale('radial', datum.value) * cos(scale('angular', datum.key))"
       },
       "y": {
        "signal": "0.5 * height + scale('radial', datum.value) * sin(scale('angular', datum.key))"
       },
       "stroke": {
        "scale": "color",
        "field": {
         "parent": "category"
        }
       },
       "strokeWidth": {
        "value": 2.5
       },
       "fill": {
        "scale": "color",
        "field": {
         "parent": "category"
        }
       },
       "fillOpacity": {
        "value": 0.12
       }
      }
     }
    },
    {
